# Copy to .env and fill in. Never commit .env.

# GitHub personal access token (repo scope) used to read diffs and open PRs
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook (used for HMAC verification)
WEBHOOK_SECRET=

# OpenAI-compatible LLM endpoint (Groq by default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# SQLite memory location
DATABASE_URL=sqlite:///docdrift.db
