# Copy to .env and fill in (or run `driftless init`). Never commit .env.
# Only GITHUB_TOKEN and LLM_API_KEY are required; everything else has a default.

# GitHub personal access token (repo scope) used to read diffs and open PRs
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook (used for HMAC verification)
WEBHOOK_SECRET=

# OpenAI-compatible LLM endpoint (Groq by default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Client-side pacing in tokens/minute (Groq free tier: 8000). 0 disables.
LLM_TPM_LIMIT=8000
# reasoning_effort for reasoning models (low|medium|high); leave empty if unsupported.
LLM_REASONING_EFFORT=low

# SQLite memory location
DATABASE_URL=sqlite:///driftless.db

# Executable docs: run documented curl/http examples against the repo's FastAPI app.
# This executes the repository's code locally; only enable it for repos you trust.
EXECUTE_EXAMPLES=true
SANDBOX_CACHE_DIR=.driftless_cache
SANDBOX_STARTUP_TIMEOUT=30
SANDBOX_INSTALL_TIMEOUT=600
# Per documented request, seconds
EXAMPLE_REQUEST_TIMEOUT=10

# Web app (served by `driftless serve` at http://127.0.0.1:8000/): repos it may act on with
# GITHUB_TOKEN, comma-separated `owner/name` or `owner/*`. Empty = the web app serves no repo.
ALLOWED_REPOS=
# Home-page shortcuts (comma-separated owner/name), e.g. debopamghosh12/driftless-demo
FEATURED_REPOS=

# Public demo (see README "Deploy your own (Render)"): visitors may only run checks/analyses;
# writes to GitHub need an admin login with ADMIN_TOKEN.
PUBLIC_DEMO=false
ADMIN_TOKEN=
DEMO_MAX_JOBS=2
DEMO_MAX_JOBS_PER_REPO=1
# Job starts per client IP per window (seconds)
DEMO_RATE_LIMIT=5
DEMO_RATE_WINDOW_S=600
# Header the host's proxy puts the client IP in (last entry used), e.g. X-Forwarded-For. Empty: socket peer.
CLIENT_IP_HEADER=
